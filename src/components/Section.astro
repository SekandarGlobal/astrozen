---
interface Props {
  text: string;
  href: string;
}

const { text, href } = Astro.props;
---

<section id={href} class="border-t border-[#DDD7CE] py-24 md:py-32">
  <h2 class="mb-14 max-w-3xl font-serif text-5xl leading-none font-bold tracking-[-0.05em] text-[#24231F] md:text-6xl">{text === "About Me" ? "Building Digital Products with Purpose" : text === "Contact" ? "Let's Start a Conversation" : text}</h2>
  <slot />
</section>
