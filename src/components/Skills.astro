---
import Section from "./Section.astro";

interface SkillGroup {
  title: string;
  items: string[];
}

const { skills } = Astro.props as { skills: SkillGroup[] };
---

<Section text="Areas of Focus" href="skills">
  <p class="mb-12 max-w-2xl text-base leading-8 text-[#696861] md:text-lg">My interests and working areas span software development, product building, and emerging technologies.</p>
  <div class="grid gap-10 sm:grid-cols-2">
    {skills.map((skill) => (
      <div class="border-t border-[#DDD7CE] pt-5">
        <h3 class="mb-4 font-serif text-3xl font-medium tracking-[-0.03em] text-[#A34838]">{skill.title}</h3>
        <ul class="space-y-3 text-base leading-7 text-[#696861]">
          {skill.items.map((item) => <li class="before:mr-3 before:text-[#A34838] before:content-['—']">{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</Section>
