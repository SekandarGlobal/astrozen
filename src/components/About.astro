---
import Section from "./Section.astro";
import type { AboutProps } from "@types";
const { description } = Astro.props as AboutProps;
---

<Section text="About Me" href="about">
  <div class="max-w-3xl"><div class="mb-8 h-px w-16 bg-[#4355DB]"></div><p class="whitespace-pre-line text-base leading-8 text-[#626875] md:text-lg">{description}</p></div>
</Section>
