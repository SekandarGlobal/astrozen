---
import Section from "./Section.astro";
import type { ProjectProps } from "@types";

interface Props { projects: ProjectProps[]; }
const { projects } = Astro.props;
---

<Section text="Selected Work" href="projects">
  <p class="mb-12 max-w-2xl text-base leading-8 text-[#696861] md:text-lg">A selection of digital products and development work that reflects my interests in technology, software, and product development.</p>
  <div class="grid gap-5 md:grid-cols-2">
    {projects.map(({ name, category, summary }, index) => (
      <article class="group min-h-64 border-t border-[#A16C5D] px-1 pt-6 transition-colors duration-300 hover:bg-[#EFEBE4] md:p-7 md:pt-6">
        <div class="mb-14"><span class="text-xs font-medium tracking-[0.18em] text-[#A34838]">0{index + 1}</span></div>
        <p class="mb-3 text-xs font-medium tracking-[0.14em] text-[#696861] uppercase">{category}</p>
        <h3 class="mb-4 font-serif text-4xl leading-none font-medium tracking-[-0.03em] text-[#24231F]">{name}</h3>
        <p class="max-w-md text-base leading-7 text-[#696861]">{summary}</p>
      </article>
    ))}
  </div>
</Section>
