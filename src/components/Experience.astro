---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";
interface Props { experience: ExperienceProps[]; }
const { experience } = Astro.props;
---

<Section text="Experience" href="experience">
  {experience.map(({ company, position, startDate, endDate, summary }) => (
    <div class="max-w-3xl border-l border-[#A16C5D] pl-6 md:pl-8">
      <h3 class="mb-2 font-serif text-4xl font-medium tracking-[-0.03em] text-[#24231F]">{company}</h3>
      <div class="mb-7 flex flex-col items-start"><h4 class="font-serif text-2xl font-medium text-[#A34838]">{position}</h4>{endDate && <span class="mt-2 text-xs font-medium tracking-[0.12em] text-[#696861] uppercase">{startDate ? `${startDate} — ${endDate}` : endDate}</span>}</div>
      {Array.isArray(summary) ? <ul class="list-none">{summary.map((log) => <li class="relative mb-4 pl-6 text-base leading-8 text-[#696861] before:absolute before:top-0 before:left-0 before:text-[#A34838] before:content-['—']">{log}</li>)}</ul> : <p class="text-base leading-8 text-[#696861]">{summary}</p>}
    </div>
  ))}
</Section>
