---
const { name, specialty, summary, email } = Astro.props;
---

<section class="grid gap-12 py-24 md:grid-cols-[1.1fr_0.9fr] md:items-end md:gap-20 md:py-36" id="hero">
  <div>
      <h1 class="mb-7 max-w-3xl font-serif text-6xl leading-[0.95] font-bold tracking-[-0.06em] text-[#24231F] sm:text-7xl md:text-8xl">{name}</h1>
    <p class="mb-8 max-w-2xl font-serif text-3xl leading-tight font-medium tracking-[-0.03em] text-[#A34838] sm:text-4xl">{specialty}</p>
  </div>
  <div class="md:pb-1">
    <p class="mb-9 max-w-xl text-base leading-8 text-[#696861] md:text-lg">{summary}</p>
    <a class="inline-flex items-center border-b border-[#A34838] pb-2 text-sm font-medium tracking-[0.1em] text-[#A34838] uppercase transition-colors hover:border-[#24231F] hover:text-[#24231F]" href={email ? `mailto:${email}` : "mailto:sekandar.dev@gmail.com"}>Get in Touch <span class="ml-3" aria-hidden="true">↗</span></a>
  </div>
</section>
